{
  "name": "shippo-packing-slips",
  "version": "1.0.0",
  "description": "Automated packing slip generator using Shippo API",
  "keywords": [
    "shippo",
    "packing-slip",
    "shipping",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianespinosa/shippo-packing-slips.git"
  },
  "author": "Brian Espinosa <b@bje.co>",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "ncc build src/index.ts -o dist/bundle --minify",
    "check": "biome check --write ./",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "download:fonts": "node scripts/download-fonts.mjs",
    "generate": "yarn build:bundle && yarn download:fonts && node dist/bundle/index.js",
    "postinstall": "lefthook install",
    "sort-package": "yarn dlx sort-package-json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "pdfkit": "0.17.2",
    "shippo": "2.17.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@types/node": "25.2.0",
    "@types/pdfkit": "0.17.4",
    "@vercel/ncc": "0.38.4",
    "@vitest/coverage-v8": "3.2.4",
    "lefthook": "2.1.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.12.0"
}
