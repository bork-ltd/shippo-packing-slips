{
  "name": "shippo-packing-slips",
  "version": "1.0.0",
  "description": "Automated packing slip generator using Shippo API",
  "keywords": [
    "shippo",
    "packing-slip",
    "shipping",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianespinosa/shippo-packing-slips.git"
  },
  "author": "Brian Espinosa <b@bje.co>",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "ncc build src/index.ts -o dist/bundle --minify",
    "check": "biome check --write ./",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "download:fonts": "node scripts/download-fonts.mjs",
    "generate": "pnpm build:bundle && pnpm download:fonts && node dist/bundle/index.js",
    "postinstall": "lefthook install",
    "preview:packing-slips": "pnpm build && node scripts/download-fonts.mjs dist/services && node dist/scripts/generate-packing-slip-preview.js",
    "sort-package": "pnpm dlx sort-package-json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "pdfkit": "0.20.2",
    "shippo": "2.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.7",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.0.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
