{
  "permissions": {
    "allow": [
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(node:*)",
      "Bash(npm show:*)",
      "Bash(npx biome check:*)",
      "Bash(npx tsc:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm node:*)",
      "Bash(pnpm test:api:*)",
      "Bash(pnpm typecheck:*)",
      "WebFetch(domain:docs.goshippo.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:goshippo.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(cat .env*:*)",
      "Bash(env:*)",
      "Bash(export:*)",
      "Bash(grep * .env*:*)",
      "Bash(node -e:*)",
      "Bash(node -p:*)",
      "Bash(printenv:*)",
      "Bash(source .env*:*)",
      "Edit(file:.env*)",
      "Read(file:.env*)",
      "Write(file:.env*)"
    ]
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
