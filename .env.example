# Shippo API Configuration
# Get your API tokens from: https://goshippo.com/user/apikeys/

# Production token - used by the main application
# Format: shippo_live_*
SHIPPO_API_TOKEN=your_shippo_live_token_here

# Cron Configuration
# How often the script runs (must match the actual crontab interval) and,
# together with the 2x lookback below, how tight the labels fetch window is.
CRON_TIME_WINDOW_MINUTES=60

# Normal baseline lookback for the packing-slips (orders) fetch, in minutes.
# Independent of CRON_TIME_WINDOW_MINUTES: a shop integration (Etsy,
# Shopify, ...) can take hours to sync an order's status to PAID after its
# placed_at, and the fetch filters on placed_at — once a run's window
# slides past an order's placed_at, it can never be matched again on its
# own, even though nothing errored (see docs/ARCHITECTURE.md "Resilience to
# outages"). Labels have no such lag (we create them ourselves) and always
# use the tight 2x CRON_TIME_WINDOW_MINUTES window. Default: 1440 (24 hours).
ORDERS_LOOKBACK_MINUTES=1440

# Maximum minutes a fetch window is allowed to widen back to, when recovering
# from an outage longer than the normal baseline lookback (see
# docs/ARCHITECTURE.md "Resilience to outages"). Default: 10080 (7 days).
MAX_LOOKBACK_MINUTES=10080

# Persistent state directory: fetch watermarks, print markers, pickup
# sentinel. Default: ~/.shippo-state (must NOT be /tmp — it is tmpfs and is
# cleared on reboot, which would defeat outage recovery).
STATE_DIR=

# CUPS Printer Configuration
# Run `lpstat -p` to list available printer names
CUPS_PRINTER_NAME=

# Company / packing slip header
COMPANY_NAME=
COMPANY_ADDRESS_LINE_1=
COMPANY_ADDRESS_LINE_2=
COMPANY_ADDRESS_LINE_3=

# Absolute or relative path to logo image (optional)
COMPANY_LOGO_PATH=

# Pickup Scheduling
# Carrier account and pickup address are resolved automatically from the Shippo API.
# Valid values: "Front Door", "Back Door", "Ring Bell", "Knock on Door",
#   "In/At Mailbox", "Mail Room", "Office", "Other", "Reception", "Side Door"
PICKUP_BUILDING_LOCATION_TYPE=Front Door
# Required only when PICKUP_BUILDING_LOCATION_TYPE=Other
PICKUP_INSTRUCTIONS=

# Behavior
# Set to true to fetch all order statuses instead of only PAID
INCLUDE_ALL_ORDER_STATUSES=

# Notifications (optional)
# Slack incoming webhook URL. When set, a message is posted for each printed
# packing slip, each printed label, and each error. Unset = no notifications.
SLACK_WEBHOOK_URL=

# Monitoring (optional)
# Dead-man's-switch ping URL (e.g. healthchecks.io). Pinged only after a
# successful run; the monitor alerts when a ping does not arrive. Set the
# check's period to match CRON_TIME_WINDOW_MINUTES, with a few minutes of
# grace so one transient network blip does not false-alarm. Unset = no pings.
HEALTHCHECK_PING_URL=
